"InstallScript"
{
	"Firewall"
	{
		"SlimeVR"		"%INSTALLDIR%\\slimevr.exe"
	}
	"Run Process"
	{
		"InstallDrivers"
		{
			"process 1"		"cmd.exe"
			"command 1"		"/c %WinDir%\\sysnative\\pnputil.exe /add-driver \"%INSTALLDIR%\\slimevr_usb_drivers\\*.inf\" /subdirs /install > \"%INSTALLDIR%\\driver_install.log\" 2>&1"
		}
	}
}
