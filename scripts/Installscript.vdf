"InstallScript"
{
    "Firewall"
    {
        "SlimeVR"        "%INSTALLDIR%\\slimevr.exe"
    }
    "Registry"
    {
        "HKEY_CURRENT_USER\\Software\\Valve\\Steam\\Apps\\3245490"
        {
            "string"
            {
                "DriversInstalled"    "1"
            }
        }
    }
    "Run Process"
    {
        "InstallUSBDrivers"
        {
            "HasRunKey"        "HKEY_CURRENT_USER\\Software\\Valve\\Steam\\Apps\\3245490"
            "process 1"        "%WinDir%\\System32\\pnputil.exe"
            "command 1"        "/add-driver \"%INSTALLDIR%\\drivers\\*.inf\" /subdirs /install"
            "NoCleanUp"        "1"
        }
    }
}
