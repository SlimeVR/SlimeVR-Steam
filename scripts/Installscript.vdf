"InstallScript"
{
    "Firewall"
    {
        "SlimeVR" "%INSTALLDIR\\slimevr.exe"
    }
    "Run Process"
    {
        "InstallUSBDrivers"
        {
            "Process 1" "%WinDir%\\System32\\pnputil.exe"
            "Command 1" "/add-driver \"%INSTALLDIR%\\drivers\\*.inf\" /subdirs /install"
            "NoCleanUp" "1"
        }
    }
}
